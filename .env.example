# --- Database -----------------------------------------------------------
# Production: Namecheap shared hosting via cPanel's Node.js App feature,
# which provisions a MySQL/MariaDB database — not standalone Postgres.
#
# cPanel prefixes both the database name AND the database user with your
# cPanel account username, e.g. a cPanel user "mediacom" creating a database
# named "licensing" and a user "licuser" actually gets:
#   database: mediacom_licensing
#   user:     mediacom_licuser
# Use those full prefixed names in the URL below, not the names you typed
# into cPanel's "Create Database"/"Create User" forms.
#
# Example (cPanel MySQL, connecting from the same host — typical for the
# Node.js App feature, which runs on the same server as the database):
# DATABASE_URL="mysql://cpaneluser_dbuser:PASSWORD@localhost:3306/cpaneluser_dbname"
DATABASE_URL="mysql://user:password@localhost:3306/mediacom_licensing"

# --- LEGACY Ed25519 signing keypair ---------------------------------------
# Used only by the deprecated /activate + /validate shim (kept for backward
# compat with intercom-app's existing callers — see src/routes/public.ts).
# Generate with: npm run generate-keypair
# Private key NEVER gets committed or shared. Public key is embedded in the
# desktop app separately (not part of this repo).
LICENSE_SIGNING_PRIVATE_KEY="base64-encoded-32-byte-ed25519-secret-key"

# --- Phase 1: device activation API (src/routes/apiDevice.ts) ------------
# New Ed25519 signing keypair — node:crypto-based (PKCS8 PEM), a DIFFERENT,
# incompatible format from LICENSE_SIGNING_PRIVATE_KEY above. Generate with:
# npm run generate-signing-keys. Must point outside this repo; that path
# must be gitignored wherever it actually lives (this var only names the
# path, it doesn't create or protect the file).
LICENSE_PRIVATE_KEY_PATH="/absolute/path/outside/this/repo/license_signing_key.pem"
# HMAC pepper for License.keyHash (server-side secret, not per-record — see
# src/lib/keygen.ts's hashKeyWithPepper()). Generate: openssl rand -hex 32
LICENSE_KEY_PEPPER="64-char-hex-random-string"
# AES-256-GCM key (exactly 32 bytes / 64 hex chars) for License.keyEncrypted
# (src/lib/keyEncryption.ts) — lets a future admin portal "reveal key" a
# previously-issued license. Generate: openssl rand -hex 32
LICENSE_KEY_ENC_KEY="64-char-hex-random-string"
# Salt mixed into device fingerprints before hashing (src/lib/fingerprint.ts)
# — the raw fingerprint is never stored. Generate: openssl rand -hex 32
FINGERPRINT_SALT="64-char-hex-random-string"
# Offline grace window (days) a device activation token stays valid before
# it must call /api/device/refresh again — never extended past the
# license's own expiresAt. Default 30 if unset.
LEASE_DAYS=30
# Optional. Raises the default 10-req/15-min /activate rate limit — only
# meant for a staging environment's own regression testing (see
# scripts/test-licensing.js), never set this in production.
# DEVICE_ACTIVATE_RATE_LIMIT=50

# --- Phase 3: release management (src/routes/adminReleases.ts, portalReleases.ts) ---
# Local-disk directory uploaded installers are streamed into — no object
# storage (S3/R2) is configured for this project. Must exist/be creatable and
# writable by the app; must have enough free space for however many installer
# versions you keep (each up to RELEASE_MAX_UPLOAD_SIZE_MB below).
RELEASES_STORAGE_DIR="/absolute/path/outside/this/repo/releases-storage"
# Signs short-lived portal download tokens (src/services/releaseDownload.ts).
# Generate: openssl rand -hex 32
RELEASE_DOWNLOAD_SECRET="64-char-hex-random-string"
# How long a signed download link stays valid. Default 10 if unset.
RELEASE_DOWNLOAD_TTL_MINUTES=10
# Rejects an upload larger than this (multer's limits.fileSize). Default 500 if unset.
RELEASE_MAX_UPLOAD_SIZE_MB=500

# --- Phase 4: customer portal auth (src/routes/portalAuth.ts) --------------
# Signs the portal's httpOnly session cookie. Generate: openssl rand -hex 32
CUSTOMER_SESSION_SECRET="64-char-hex-random-string"
# How long a portal login session lasts. Default 14 if unset.
CUSTOMER_SESSION_DAYS=14
# How long a magic-link login token stays valid. Default 15 if unset.
MAGIC_LINK_TTL_MINUTES=15
# Origin of the customer portal frontend — used both for its CORS allowlist
# and to build the link emailed to customers (<PORTAL_URL>/login/verify?token=...).
PORTAL_URL="http://localhost:5175"
# Staging-only test escape hatch for scripts/test-licensing.js — includes
# the raw magic-link token in POST /api/portal/auth/request-link's response
# so the script can log in without a real inbox. NEVER set in production;
# only takes effect at all when NODE_ENV=staging.
# TEST_EXPOSE_MAGIC_LINK=1

# --- Admin auth ------------------------------------------------------------
# Secret used to sign admin JWTs. Use a long random string in production.
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"
# How long an admin JWT stays valid, e.g. "15m", "1h".
ADMIN_JWT_EXPIRES_IN="1h"

# --- CORS --------------------------------------------------------------
# Origin allowed to call /admin/* routes (your admin dashboard's URL).
# Public routes (/activate, /validate) are not CORS-restricted.
ADMIN_DASHBOARD_ORIGIN="http://localhost:5173"

# --- Server --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Transactional email (stubbed) ---------------------------------------
# Not wired to a real provider yet. sendLicenseEmail() just logs by default.
# When you plug in Resend/Postmark, add their API key here.
# RESEND_API_KEY=
# EMAIL_FROM="MediaCom Licensing <licensing@mediacom.example.com>"
